{
  "manifest_version": 3,
  "name": "EkClick — Classroom Downloads",
  "description": "Select and organize attachments from the current Google Classroom post.",
  "version": "0.5.1",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage", "scripting", "downloads"],
  "host_permissions": ["https://classroom.google.com/*"],
  "optional_host_permissions": [
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "EkClick",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    }
  },
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://classroom.google.com/*"],
    "js": ["shared/core.js", "content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "settings.html",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
